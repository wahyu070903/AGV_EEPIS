<?xml version="1.0" ?>
<robot name="ddmr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ddmr_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find ddmr_description)/urdf/ddmr.ros2control" />
  <xacro:include filename="$(find ddmr_description)/urdf/ddmr.gazebo" />

  <link name="base_footprint"></link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>
  
  <link name="base_link">
    <inertial>
      <origin xyz="0.002012 0.000000 0.058435" rpy="0 0 0"/>
      <mass value="25.96071096243103"/>
      <inertia
        ixx="0.093648"
        iyy="0.089883"
        izz="0.129137"
        ixy="0.0"
        iyz="0.003165"
        ixz="0.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh
          filename="file://$(find ddmr_description)/meshes/base_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh
          filename="file://$(find ddmr_description)/meshes/base_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="rwheel">
    <inertial>
      <origin xyz="0.0 0.01575 0.0" rpy="0 0 0"/>
      <mass value="0.898023945869377"/>
      <inertia
        ixx="0.000519"
        iyy="0.000334"
        izz="0.000334"
        ixy="0.0"
        iyz="0.0"
        ixz="0.0"/>
    </inertial>

    <visual>
      <origin
        xyz="0.0475 0.0635 -0.025"
        rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh
          filename="file://$(find ddmr_description)/meshes/rwheel.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <collision>
      <origin
        xyz="0.0475 0.0635 -0.025"
        rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh
          filename="file://$(find ddmr_description)/meshes/rwheel.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="lwheel">
    <inertial>
      <origin xyz="0.0 -0.01575 0.0" rpy="0 0 0"/>
      <mass value="0.8980239458693772"/>
      <inertia
        ixx="0.000519"
        iyy="0.000334"
        izz="0.000334"
        ixy="0.0"
        iyz="0.0"
        ixz="0.0"/>
    </inertial>

    <visual>
      <origin
        xyz="0.0475 -0.0635 -0.025"
        rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh
          filename="file://$(find ddmr_description)/meshes/lwheel.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <collision>
      <origin
        xyz="0.0475 -0.0635 -0.025"
        rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh
          filename="file://$(find ddmr_description)/meshes/lwheel.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0095" rpy="0 0 0"/>
      <mass value="0.11932"/>
      <inertia
        ixx="8e-06"
        iyy="1.9e-05"
        izz="2e-05"
        ixy="0.0"
        iyz="0.0"
        ixz="0.0"/>
    </inertial>

    <visual>
      <origin
        xyz="-0.0775 0.0 -0.113"
        rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh
          filename="file://$(find ddmr_description)/meshes/camera_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <collision>
      <origin
        xyz="-0.0775 0.0 -0.113"
        rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh
          filename="file://$(find ddmr_description)/meshes/camera_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="Revolute 1" type="continuous">
    <origin
      xyz="-0.0475 -0.0635 0.025"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="rwheel"/>

    <!-- Wheel axle is now Y -->
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="Revolute 2" type="continuous">
    <origin
      xyz="-0.0475 0.0635 0.025"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="lwheel"/>

    <!-- Wheel axle is now Y -->
    <axis xyz="0 -1 0"/>
  </joint>

  <joint name="Rigid 3" type="fixed">
    <origin
      xyz="0.0775 0 0.113"
      rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

</robot>