</joint>

<joint name="Rigid 10" type="fixed">
  <origin xyz="-0.05 0.29 1.035" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="steer_head_1"/>
</joint>

<joint name="l_wheel_joint" type="continuous">
  <origin xyz="0.0 -0.345 -0.307859" rpy="0 0 0"/>
  <parent link="steering_1"/>
  <child link="l_wheel_1"/>
  <axis xyz="0.0 -1.0 -0.0"/>
</joint>

<joint name="r_wheel_joint" type="continuous">
  <origin xyz="0.0 0.345 -0.307859" rpy="0 0 0"/>
  <parent link="steering_1"/>
  <child link="r_wheel_1"/>
  <axis xyz="0.0 -1.0 -0.0"/>
</joint>

<joint name="steering_joint" type="revolute">
  <origin xyz="-0.852 -0.29 -0.501947" rpy="0 0 0"/>
  <parent link="steer_head_1"/>
  <child link="steering_1"/>
  <axis xyz="-0.0 -0.0 1.0"/>
  <limit upper="-0.7853982" lower="0.7853982" effort="100" velocity="100"/>
</joint>

<!-- custom joint for sensors -->
<joint name="camera_joint" type="fixed">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camera_link"/>
</joint>

</robot>
