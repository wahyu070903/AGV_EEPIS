<joint name="lift_joint" type="prismatic">
  <origin xyz="0.05 -0.256 1.99" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="stacker_slider_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit upper="1.0" lower="0.0" effort="100" velocity="100"/>
</joint>

<joint name="Rigid 2" type="fixed">
  <origin xyz="0.075 -0.119 -1.5" rpy="0 0 0"/>
  <parent link="stacker_slider_1"/>
  <child link="stacker_fork_1"/>
</joint>

<joint name="r_caster_joint" type="continuous">
  <origin xyz="-0.265391 -0.32 0.265" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="r_caster_1"/>
  <axis xyz="-0.0 0.0 -1.0"/>
</joint>

<joint name="l_caster_joint" type="continuous">
  <origin xyz="-0.27 0.32 0.265" rpy="0 0 0"/>
