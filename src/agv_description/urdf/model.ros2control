<?xml version="1.0" ?>
<robot name="model" xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <gazebo>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
            <joint_name>l_wheel_joint</joint_name>
            <joint_name>r_wheel_joint</joint_name>
            <topic>/robot_model/wheel_cmd_vel</topic>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>steering_joint</joint_name>
            <topic>/robot_model/steer_cmd_pos</topic>
            <p_gain>1000</p_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>l_wheel_joint</joint_name>
            <joint_name>r_wheel_joint</joint_name>
            <joint_name>steering_joint</joint_name>
            <joint_name>lift_joint</joint_name>
            <joint_name>r_caster_joint</joint_name>
            <joint_name>l_caster_joint</joint_name>
            <joint_name>r_caster_wheel_joint</joint_name>
            <joint_name>l_caster_wheel_joint</joint_name>
            <joint_name>r_static_wheel_joint</joint_name>
            <joint_name>l_static_wheel_joint</joint_name>
        </plugin>
    </gazebo>
</robot>
