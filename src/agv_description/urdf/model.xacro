<joint name="steering_joint" type="revolute">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="steering_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit upper="0.453786" lower="-0.453786" effort="100" velocity="100"/>
</joint>

<joint name="rr_wheel_joint" type="continuous">
  <origin xyz="0.0 -0.335 -0.27" rpy="0 0 0"/>
  <parent link="steering_1"/>
  <child link="rr_wheel_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="lr_wheel_joint" type="continuous">
  <origin xyz="0.0 0.335 -0.27" rpy="0 0 0"/>
  <parent link="steering_1"/>
  <child link="lr_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Rigid 16" type="fixed">
  <origin xyz="0.849999 -0.290502 0.114" rpy="0 0 0"/>
